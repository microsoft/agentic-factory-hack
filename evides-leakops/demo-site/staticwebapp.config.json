{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/img/*", "/css/*", "/js/*", "*.svg", "*.css", "*.js"]
  },
  "routes": [
    { "route": "/js/*", "headers": { "cache-control": "public, max-age=300, must-revalidate" } },
    { "route": "/css/*", "headers": { "cache-control": "public, max-age=300, must-revalidate" } },
    { "route": "/img/*", "headers": { "cache-control": "public, max-age=86400" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
